//@version=6
// v6의 전략 주문 제한은 기본적으로 초과 주문을 잘라내므로,
// v5와 같은 백테스트는 v5가 허용하는 주문 수 이내에서만 보장됩니다.
strategy("v5 예제 — 거래량 돌파", overlay = true, initial_capital = 10000000, currency = currency.KRW, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, margin_long = 0, margin_short = 0)

// v6의 기본 증거금 비율은 100%이지만 v5 기본값은 0%이므로 위에서 명시합니다.
// 그 밖의 체결·계산 관련 설정은 이 전략에서 v5와 동일한 기본값을 유지합니다.
len = input.int(15, "기간", minval = 2)
// len은 입력 정수이므로 v5와 v6 모두 정수 나눗셈을 합니다.
// 상수 정수끼리의 나눗셈 결과가 v6에서 달라지는 문제는 여기에 해당하지 않습니다.
half = len / 2
ma = ta.sma(close, half)
volAvg = ta.sma(volume, 20)

// v6 bool은 na를 가질 수 없어 false로 초기화합니다.
// 원본에서도 매 바 초기값을 읽기 전에 덮어쓰므로 결과는 같습니다.
var bool trendOk = false
trendOk := close > ma

// v6에서는 숫자를 조건으로 암묵 변환할 수 없습니다.
// v5의 조건식에서 na와 0은 거짓, 그 외 숫자는 참입니다.
hasVolume = not na(volume) and volume != 0
volUp = hasVolume and volume > volAvg * 2

// v6에서 when이 제거되어 if로 대체합니다.
// crossover/crossunder는 매 바 계산해 원본과 동일한 시계열 이력을 유지합니다.
crossUp = ta.crossover(close, ma)
crossDown = ta.crossunder(close, ma)
if crossUp and volUp
    strategy.entry("L", strategy.long)
if crossDown
    strategy.close("L")

plot(ma, "이동평균", color = color.orange)
