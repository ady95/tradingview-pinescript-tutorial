//@version=6
indicator("07-3 거래량 급증·추세 돌파 스크리너", overlay = true)

const string GRP_C = "조건"
volMult = input.float(3.0, "거래량 급증 배수", minval = 1, step = 0.5, group = GRP_C)
highLen = input.int(20, "신고가 기간", minval = 5, group = GRP_C)
trendLen = input.int(60, "추세 EMA 기간", minval = 5, group = GRP_C)
minTurnover = input.float(50.0, "최소 거래대금(억 원)", minval = 0, step = 10, group = GRP_C)

trendEma = ta.ema(close, trendLen)
volRatio = volume / ta.sma(volume, 20)
prevHigh = ta.highest(high, highLen)[1]
turnover = close * volume / 100000000  // 거래대금(억 원) 근사치

// 1) 거래량 급증: 평소의 volMult배 이상
volumeSurge = volRatio >= volMult
// 2) 추세 돌파: 직전 highLen개 캔들의 최고가를 종가로 넘어섬
breakout = close > prevHigh
// 3) 추세 확인: 종가가 추세 EMA 위
uptrend = close > trendEma
// 4) 유동성: 거래대금이 너무 작은 종목 제외
liquid = turnover >= minTurnover

candidate = volumeSurge and breakout and uptrend and liquid
barsSinceCandidate = ta.barssince(candidate)

screenerOnly = display.data_window + display.pine_screener
plot(candidate ? 1 : 0, "후보", display = screenerOnly)
plot(volRatio, "거래량 배수", display = screenerOnly)
plot((close - prevHigh) / prevHigh * 100, "신고가 대비(%)", display = screenerOnly)
plot((close - trendEma) / trendEma * 100, "EMA 이격도(%)", display = screenerOnly)
plot(turnover, "거래대금(억)", display = screenerOnly)
plot(barsSinceCandidate, "후보 후 경과 캔들", display = screenerOnly)

// 차트에서 볼 때를 위한 표시
plot(trendEma, "추세 EMA", color = color.gray)
plot(prevHigh, "직전 최고가", color = color.new(color.red, 50), style = plot.style_stepline)
plotshape(candidate, "후보 캔들", shape.labelup, location.belowbar, color.red, text = "후보", textcolor = color.white, size = size.small)

alertcondition(candidate, "거래량 급증 + 돌파", "거래량 급증과 신고가 돌파가 함께 나타났습니다")
alertcondition(volumeSurge and liquid, "거래량 급증만", "거래량이 평소보다 크게 늘었습니다")
