//@version=6
indicator("07-2 스크리닝 지표", overlay = false)

const string GRP_C = "조건"
emaLen = input.int(60, "추세 EMA 기간", minval = 1, group = GRP_C)
rsiMin = input.int(50, "RSI 하한", minval = 0, maxval = 100, group = GRP_C)
volMult = input.float(1.5, "거래량 배수", minval = 0.1, step = 0.1, group = GRP_C)

ema = ta.ema(close, emaLen)
rsi = ta.rsi(close, 14)
volRatio = volume / ta.sma(volume, 20)
chg = (close - close[1]) / close[1] * 100
distEma = (close - ema) / ema * 100

// 조건마다 참이면 1, 거짓이면 0인 숫자로 바꾼다 — 스크리너 필터에서 "= 1"로 거를 수 있다
trendOk = close > ema and ema > ema[1]
momentumOk = rsi >= rsiMin
volumeOk = volRatio >= volMult
trendNum = trendOk ? 1 : 0
momentumNum = momentumOk ? 1 : 0
volumeNum = volumeOk ? 1 : 0
score = trendNum + momentumNum + volumeNum

// 차트에는 점수만 그리고, 나머지는 데이터 창과 스크리너 열에만 보이게 한다
screenerOnly = display.data_window + display.pine_screener
plot(score, "점수", color = score == 3 ? color.red : color.gray, style = plot.style_columns)
plot(trendNum, "추세", display = screenerOnly)
plot(momentumNum, "모멘텀", display = screenerOnly)
plot(volumeNum, "거래량", display = screenerOnly)
plot(chg, "등락률(%)", display = screenerOnly)
plot(rsi, "RSI", display = screenerOnly)
plot(volRatio, "거래량 배수", display = screenerOnly)
plot(distEma, "EMA 이격도(%)", display = screenerOnly)
hline(3, "만점", color = color.red, linestyle = hline.style_dotted)

// 스크리너가 자동으로 불러오는 알림 조건은 앞의 두 개다
alertcondition(score == 3, "세 조건 모두 충족", "추세·모멘텀·거래량 조건을 모두 만족했습니다")
alertcondition(score == 3 and score[1] < 3, "오늘 새로 충족", "오늘 처음으로 세 조건을 모두 만족했습니다")
