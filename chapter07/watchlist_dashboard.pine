//@version=6
indicator("07-4 후보 종목 모니터링", overlay = true)

const string GRP_S = "후보 종목"
s1 = input.symbol("KRX:005930", "종목 1", group = GRP_S)
s2 = input.symbol("KRX:000660", "종목 2", group = GRP_S)
s3 = input.symbol("KRX:035420", "종목 3", group = GRP_S)
s4 = input.symbol("KRX:005380", "종목 4", group = GRP_S)
s5 = input.symbol("KRX:051910", "종목 5", group = GRP_S)
s6 = input.symbol("KRX:068270", "종목 6", group = GRP_S)
volMult = input.float(2.0, "거래량 급증 배수", minval = 1, step = 0.5)

// 한 종목의 상태를 계산하는 함수 — request.security() 안에서 그 종목 기준으로 실행된다
status() =>
    chg = (close - close[1]) / close[1] * 100
    rsi = ta.rsi(close, 14)
    volRatio = volume / ta.sma(volume, 20)
    breakout = close > ta.highest(high, 20)[1]
    [close, chg, rsi, volRatio, breakout]

symbols = array.from(s1, s2, s3, s4, s5, s6)

var table dash = table.new(position.top_right, 6, 7, bgcolor = color.new(color.white, 10), border_color = color.gray, border_width = 1)
if barstate.islast
    dash.cell(0, 0, "종목", text_color = color.black)
    dash.cell(1, 0, "종가", text_color = color.black)
    dash.cell(2, 0, "등락률", text_color = color.black)
    dash.cell(3, 0, "RSI", text_color = color.black)
    dash.cell(4, 0, "거래량", text_color = color.black)
    dash.cell(5, 0, "상태", text_color = color.black)

// v6의 동적 요청: 반복문 안에서 종목을 바꿔 가며 요청할 수 있다 (01-4)
for i = 0 to symbols.size() - 1
    sym = symbols.get(i)
    [c, chg, rsi, volRatio, breakout] = request.security(sym, timeframe.period, status())
    hot = volRatio >= volMult and breakout
    if hot and barstate.isconfirmed
        alert(sym + " 거래량 급증 + 20캔들 고가 돌파 (종가 " + str.tostring(c) + ")", alert.freq_once_per_bar_close)
    if barstate.islast
        row = i + 1
        dash.cell(0, row, sym, text_color = color.black, text_halign = text.align_left)
        dash.cell(1, row, str.tostring(c), text_color = color.black)
        dash.cell(2, row, str.tostring(chg, "0.00") + "%", text_color = chg >= 0 ? color.red : color.blue)
        dash.cell(3, row, str.tostring(rsi, "0.0"), text_color = rsi > 70 ? color.red : rsi < 30 ? color.blue : color.black)
        dash.cell(4, row, str.tostring(volRatio, "0.0") + "배", text_color = volRatio >= volMult ? color.orange : color.black)
        dash.cell(5, row, hot ? "급증+돌파" : breakout ? "돌파" : "-", text_color = hot ? color.red : color.black)
