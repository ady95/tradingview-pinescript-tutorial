//@version=6
indicator("07-1 스크리너 기초", overlay = false)

// 스크리너는 plot 값을 표의 열로, alertcondition을 필터 조건으로 읽는다
chg = (close - close[1]) / close[1] * 100
rsi = ta.rsi(close, 14)
volRatio = volume / ta.sma(volume, 20)

plot(chg, "등락률(%)", color = chg >= 0 ? color.red : color.blue, style = plot.style_columns, precision = 2)
plot(rsi, "RSI", color = color.purple, precision = 2)
plot(volRatio, "거래량 배수", color = color.orange, precision = 2)

alertcondition(ta.crossover(rsi, 50), "RSI 50 상향 돌파", "RSI가 50을 상향 돌파했습니다")
alertcondition(volRatio >= 2, "거래량 2배 이상", "거래량이 20일 평균의 2배 이상입니다")
