//@version=6
indicator("v6 변경점 확인", overlay = false)

// 1) 두 정수 상수의 나눗셈: v6에서는 2.5 (v5에서는 2)
half = 5 / 2

// 2) bool은 true/false 두 값만 가진다. 숫자를 조건으로 쓰려면 명시적으로 변환한다
hasVolume = bool(volume)

// 3) and/or는 앞쪽 결과만으로 답이 정해지면 뒤쪽을 평가하지 않는다(지연 평가)
isUpWithVolume = hasVolume and close > open

plot(half, "5 / 2", color = color.blue, precision = 2)
plot(isUpWithVolume ? 1 : 0, "거래량 있는 양봉", color = color.green, style = plot.style_columns)
