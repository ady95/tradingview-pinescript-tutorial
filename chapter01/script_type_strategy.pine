//@version=6
strategy("유형 비교 — Strategy", overlay = true, initial_capital = 10000000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100)

fast = ta.sma(close, 5)
slow = ta.sma(close, 20)

plot(fast, "SMA 5", color = color.teal)
plot(slow, "SMA 20", color = color.orange)

// 전략은 같은 신호로 가상 주문을 낸다 → Strategy Tester에 성과가 집계된다
if ta.crossover(fast, slow)
    strategy.entry("Long", strategy.long)
if ta.crossunder(fast, slow)
    strategy.close("Long")
