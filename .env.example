# 이 파일을 .env로 복사한 뒤 자신의 값을 채우세요. (.env는 Git에 커밋되지 않습니다)

# ── 11장: AI로 Pine Script 개발하기 (OpenAI 호환 API) ──
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=

# ── 12장: Webhook 수신 서버 ──
# TradingView 알림 메시지(JSON)에 같은 값을 넣어 요청을 인증합니다
WEBHOOK_SECRET=change-me-to-a-long-random-string
WEBHOOK_PORT=8000

# ── 12장: 키움증권 REST API (모의투자) ──
KIWOOM_BASE_URL=https://mockapi.kiwoom.com
KIWOOM_PAPER_APP_KEY=
KIWOOM_PAPER_APP_SECRET=
KIWOOM_PAPER_ACCOUNT_NO=

# ── 12장: 리스크 한도 ──
MAX_ORDER_AMOUNT_KRW=1000000
MAX_DAILY_LOSS_KRW=300000

# ── 12장: 서버 동작 ──
# true면 주문을 보내지 않고 검증·기록만 합니다. 모의주문을 보내려면 false
DRY_RUN=true
# 주문을 허용할 종목 코드 (쉼표로 구분)
ALLOWED_TICKERS=005930,000660
