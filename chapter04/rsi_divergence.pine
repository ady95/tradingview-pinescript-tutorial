//@version=6
indicator("04-2 RSI와 다이버전스", overlay = false)

rsiLen = input.int(14, "RSI 기간", minval = 2)
pivotLen = input.int(5, "피벗 좌우 캔들 수", minval = 1)

// RSI 직접 구현: 상승폭 평균 ÷ 하락폭 평균 → 0~100으로 변환
chg = ta.change(close)
up = math.max(chg, 0)
down = -math.min(chg, 0)
avgUp = ta.rma(up, rsiLen)
avgDown = ta.rma(down, rsiLen)
myRsi = avgDown == 0 ? 100 : avgUp == 0 ? 0 : 100 - 100 / (1 + avgUp / avgDown)

plot(myRsi - ta.rsi(close, rsiLen), "RSI 차이", display = display.data_window, precision = 4)

plot(myRsi, "RSI", color = color.purple, linewidth = 2, precision = 2)
h70 = hline(70, "과매수", color = color.red, linestyle = hline.style_dashed)
h30 = hline(30, "과매도", color = color.blue, linestyle = hline.style_dashed)
fill(h70, h30, color = color.new(color.purple, 92), title = "중립 구간")

// 상승 다이버전스: 가격 저점은 낮아졌는데 RSI 저점은 높아짐
// 피벗은 오른쪽 pivotLen개 캔들이 지나야 확정되므로 pivotLen 캔들 늦게 나타난다
pl = ta.pivotlow(myRsi, pivotLen, pivotLen)
isPivot = not na(pl)
rsiNow = ta.valuewhen(isPivot, myRsi[pivotLen], 0)
rsiPrev = ta.valuewhen(isPivot, myRsi[pivotLen], 1)
lowNow = ta.valuewhen(isPivot, low[pivotLen], 0)
lowPrev = ta.valuewhen(isPivot, low[pivotLen], 1)
bullDiv = isPivot and rsiNow > rsiPrev and lowNow < lowPrev and rsiNow < 40

plotshape(bullDiv ? myRsi[pivotLen] : na, "상승 다이버전스", shape.triangleup, location.absolute, color.red, offset = -pivotLen, size = size.small)
alertcondition(bullDiv, "상승 다이버전스", "RSI 상승 다이버전스가 확인되었습니다")
